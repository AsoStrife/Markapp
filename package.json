{
    "name": "markapp",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "electron/main.js",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "format": "prettier --write --experimental-cli src/",
        "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
        "electron:build": "vite build && electron-builder",
        "electron:build:win": "vite build && electron-builder --win",
        "electron:build:mac": "vite build && electron-builder --mac",
        "electron:build:linux": "vite build && electron-builder --linux"
    },
    "dependencies": {
        "@heroicons/vue": "^2.2.0",
        "@tiptap/extension-code-block-lowlight": "^3.14.0",
        "@tiptap/extension-image": "^3.14.0",
        "@tiptap/extension-link": "^3.14.0",
        "@tiptap/extension-placeholder": "^3.14.0",
        "@tiptap/extension-table": "^3.14.0",
        "@tiptap/extension-table-cell": "^3.14.0",
        "@tiptap/extension-table-header": "^3.14.0",
        "@tiptap/extension-table-row": "^3.14.0",
        "@tiptap/extension-task-item": "^3.14.0",
        "@tiptap/extension-task-list": "^3.14.0",
        "@tiptap/extension-underline": "^3.14.0",
        "@tiptap/starter-kit": "^3.14.0",
        "@tiptap/vue-3": "^3.14.0",
        "@vueuse/core": "^14.1.0",
        "highlight.js": "^11.11.1",
        "lowlight": "^3.3.0",
        "marked": "^17.0.1",
        "pinia": "^3.0.4",
        "turndown": "^7.2.2",
        "vue": "^3.5.25",
        "vue-i18n": "^9.3.0",
        "vue-router": "^4.6.3"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.2",
        "autoprefixer": "^10.4.20",
        "concurrently": "^9.2.1",
        "cross-env": "^7.0.3",
        "electron": "^34.5.8",
        "electron-builder": "^25.1.8",
        "postcss": "^8.4.49",
        "prettier": "3.6.2",
        "tailwindcss": "^3.4.17",
        "vite": "^7.2.4",
        "vite-plugin-vue-devtools": "^8.0.5",
        "wait-on": "^8.0.5"
    },
    "build": {
        "appId": "com.markapp.editor",
        "productName": "Markapp",
        "win": {
            "target": "nsis",
            "icon": "build/icons/icon.png",
            "fileAssociations": [
                {
                    "ext": "md",
                    "name": "Markdown File",
                    "description": "Markdown Document",
                    "role": "Editor"
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": false
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "directories": {
            "buildResources": "build",
            "output": "release"
        }
    }
}
